# =============================================================================
# ASP.NET Core Web API - Multi-stage Dockerfile
# =============================================================================

# -----------------------------------------------------------------------------
# Base Stage - Runtime
# -----------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
WORKDIR /app
EXPOSE 8080

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1000 -S nexai && \
    adduser -u 1000 -S nexai -G nexai && \
    chown -R nexai:nexai /app
USER nexai

# -----------------------------------------------------------------------------
# Build Stage
# -----------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

# Install build dependencies
RUN apk add --no-cache clang build-base zlib-dev

# Copy project files for restore caching
COPY ["src/NexaAI.Api/NexaAI.Api.csproj", "NexaAI.Api/"]
COPY ["src/NexaAI.Core/NexaAI.Core.csproj", "NexaAI.Core/"]

# Restore dependencies
RUN dotnet restore "NexaAI.Api/NexaAI.Api.csproj"

# Copy source code
COPY ["src/NexaAI.Api/", "NexaAI.Api/"]
COPY ["src/NexaAI.Core/", "NexaAI.Core/"]

# Build
RUN dotnet build "NexaAI.Api/NexaAI.Api.csproj" -c Release -o /app/build

# -----------------------------------------------------------------------------
# Publish Stage
# -----------------------------------------------------------------------------
FROM build AS publish
RUN dotnet publish "NexaAI.Api/NexaAI.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# -----------------------------------------------------------------------------
# Development Stage (with hot reload)
# -----------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS development
WORKDIR /app

# Install development tools
RUN apk add --no-cache curl bash

# Install dotnet-aspnet-codegenerator and dotnet-ef for development
RUN dotnet tool install --global dotnet-aspnet-codegenerator && \
    dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/root/.dotnet/tools"

# Copy project files
COPY ["src/NexaAI.Api/NexaAI.Api.csproj", "NexaAI.Api/"]
COPY ["src/NexaAI.Core/NexaAI.Core.csproj", "NexaAI.Core/"]

# Restore
RUN dotnet restore "NexaAI.Api/NexaAI.Api.csproj"

# Keep container running for hot reload
CMD ["tail", "-f", "/dev/null"]

# -----------------------------------------------------------------------------
# Production Stage
# -----------------------------------------------------------------------------
FROM base AS production
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "NexaAI.Api.dll"]