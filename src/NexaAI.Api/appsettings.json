{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=nexai;Username=nexai;Password=changeme;Include Error Detail=true"
  },
  "Jwt": {
    "Secret": "your-super-secret-jwt-key-minimum-32-characters-long",
    "Issuer": "NexaAI",
    "Audience": "NexaAI",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "LlmModel": "llama3.1:8b",
    "EmbeddingModel": "nomic-embed-text",
    "NumCtx": 8192,
    "Temperature": 0.1
  },
  "AIService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "changeme_ai_service_key"
  },
  "Presidio": {
    "AnalyzerUrl": "http://localhost:3000",
    "AnonymizerUrl": "http://localhost:3001",
    "Enabled": true
  },
  "Storage": {
    "UploadPath": "./uploads",
    "MaxFileSizeMB": 50
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "FeatureFlags": {
    "EnableNeo4j": false,
    "EnableMcp": true,
    "EnableEvaluation": true,
    "EnablePresidio": true
  }
}