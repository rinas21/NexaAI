<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="pgvector" Version="0.2.*" />
    <PackageReference Include="System.Text.Json" Version="8.0.*" />
    <PackageReference Include="FluentValidation" Version="11.11.*" />
    <PackageReference Include="MediatR" Version="12.2.*" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.*" />
    <PackageReference Include="Ardalis.Specification" Version="8.0.*" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Mapster" Version="7.4.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.7.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.*" />
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.*" />
  </ItemGroup>

</Project>